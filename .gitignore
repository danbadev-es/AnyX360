# --- Copyrighted game data: NEVER commit ---
/raw/
/assets/
/extracted/
*.iso
*.xex
*.xexp
*.xbe
*.stfs
*.god
# .anyx backups of prepared games (docs/ANYX.md): the player's own copies
/anyx/
*.anyx
*.anyx.partial

# --- Publishers' art: shipped in the release only, NEVER commit ---
# Box art, see covers/README.md
/covers/*
!/covers/README.md
# Background art, see backgrounds/README.md
/backgrounds/*
!/backgrounds/README.md
# Reference pictures for the launcher's design
/REF.*
/ref/

# --- Console keys: NEVER commit ---
/keys/*
!/keys/README.md

# --- Generated recompiler output (derived from game code) ---
/games/*/out/
/games/*/ppc/
/games/*/recomp*/
/games/*/shaders/
# Shader caches collected while testing (tools/package/merge_shader_caches.py): shipped in the release only
/shader_cache/

# --- Build ---
/build/
/dist/
/out/
/.vs/
/.cache/
CMakeUserPresets.json
compile_commands.json
*.pdb
*.ilk
*.obj
*.exe
*.dll
*.lib
*.log

# --- Local tools ---
# Claude Code: agents' worktrees, settings and everything else it keeps here
/.claude/

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
.DS_Store
__pycache__/
